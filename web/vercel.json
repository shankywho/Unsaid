{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://unsaid-bhwr.onrender.com/v1/:path*" },
    { "source": "/auth/:path*", "destination": "https://unsaid-bhwr.onrender.com/auth/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
