# Copy to .env.prod. Never commit the filled-in file (it is git-ignored).
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
LOG_LEVEL=info
TRUST_PROXY=1                          # hops of reverse proxy in front (Railway/Render = 1)

# --- secrets (generate: openssl rand -hex 32) ---
API_KEY=
SESSION_SECRET=
OMI_WEBHOOK_SECRET=
POSTGRES_PASSWORD=                     # docker-compose.prod.yml only

# --- demo login for the future frontend ---
DEMO_EMAIL=
DEMO_PASSWORD=

# --- frontend / CORS ---
CORS_ORIGINS=https://app.example.com   # comma-separated allowlist
COOKIE_SAMESITE=lax                    # use 'none' only if the frontend is on a different site (forces Secure)

# --- data stores (managed: Neon / Upstash / Qdrant Cloud) ---
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_DIM=1536

# --- LLM: Lyzr is the mandatory agent path ---
MOCK_EXTERNALS=false
LLM_PROVIDER=lyzr
LYZR_API_KEY=
LYZR_INFERENCE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_UTTERANCE_CLASSIFIER_ID=
LYZR_AGENT_FRAGMENT_ID=
LYZR_AGENT_CONTEXT_EXTRACTOR_ID=
LYZR_AGENT_HYPOTHESIS_ID=
LYZR_AGENT_CONFIRM_ID=
LYZR_AGENT_LEARNER_ID=
LYZR_AGENT_EVAL_JUDGE_ID=

# --- embeddings + TTS ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- optional tuning ---
RATE_LIMIT_V1_PER_MIN=120
RATE_LIMIT_WEBHOOK_PER_MIN=300
RAW_TRANSCRIPT_RETENTION_DAYS=14
