{
  "name": "unsaid",
  "version": "0.1.0",
  "private": true,
  "description": "Unsaid — finishing the sentences aphasia takes away.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/src/agents/prompts && cp -r src/agents/prompts dist/src/agents/",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:learn": "tsx scripts/eval-learn.ts",
    "replay:omi": "tsx scripts/replay-omi.ts",
    "openapi": "tsx scripts/gen-openapi.ts",
    "openapi:check": "tsx scripts/gen-openapi.ts --check",
    "lyzr:setup": "tsx scripts/lyzr-setup.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "qdrant:reset": "tsx scripts/reset-qdrant.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "seed:dist": "node dist/scripts/seed.js",
    "lyzr:setup:dist": "node dist/scripts/lyzr-setup.js",
    "start:dist": "node dist/src/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@prisma/client": "^6.19.3",
    "@qdrant/js-client-rest": "^1.19.0",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "prisma": "6.19.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "MIT"
}
