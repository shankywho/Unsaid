NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
API_KEY=dev-key                      # simple bearer for /v1/* routes
MOCK_EXTERNALS=false
AUTH_DISABLED=false   # true = no login, the console opens directly (local demos only)
# MOCK_LATENCY_MS=0   # dev/demo only: delay each mocked agent call so the live trace can be watched

# docker-compose host ports (override if 5432/6379 are taken locally)
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333

DATABASE_URL=postgresql://unsaid:unsaid@localhost:5432/unsaid
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ALLOW_RESET=false               # if true, auto-drops/recreates collection on vector-size mismatch

LYZR_API_KEY=
LYZR_INFERENCE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_FRAGMENT_ID=
LYZR_AGENT_CONTEXT_EXTRACTOR_ID=
LYZR_AGENT_HYPOTHESIS_ID=
LYZR_AGENT_CONFIRM_ID=
LYZR_AGENT_LEARNER_ID=
LYZR_AGENT_UTTERANCE_CLASSIFIER_ID=
LYZR_AGENT_EVAL_JUDGE_ID=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq                     # 'groq' | 'lyzr'

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
TTS_MODEL=tts-1
TTS_VOICE=alloy

OMI_APP_ID=
OMI_APP_SECRET=
OMI_WEBHOOK_SECRET=                  # optional shared secret query param

CONFIRMATION_TIMEOUT_SEC=45
RAW_TRANSCRIPT_RETENTION_DAYS=14
